# Which game this process serves: quiz | word-pass (selects the GameStrategy).
# Mandatory: the process refuses to start without it (there is no default game).
# SERVICE_NAME, AI_ENGINE_GENERATION_ENDPOINT, AI_ENGINE_INGEST_ENDPOINT, AI_ENGINE_INGEST_SOURCE,
# BATCH_GENERATION_MAX_QUESTIONS and SERVICE_PORT (7100) default per game; set them only to override.
GAME_TYPE=quiz
NODE_ENV=development

# ai-engine generation API
AI_ENGINE_BASE_URL=http://localhost:7001
AI_ENGINE_CATALOGS_ENDPOINT=/catalogs
AI_ENGINE_API_KEY=dev_games_test_key_2026
AI_ENGINE_INGEST_API_KEY=dev_bridge_test_key_2026
AI_ENGINE_REQUEST_TIMEOUT_MS=420000
AI_ENGINE_RETRY_MAX_ATTEMPTS=8
AI_ENGINE_RETRY_INITIAL_DELAY_MS=5000
AI_ENGINE_RETRY_MAX_DELAY_MS=30000

# Monitoring
METRICS_LOG_BUFFER_SIZE=500

# Private docs (Swagger-like) for internal testing
PRIVATE_DOCS_ENABLED=true
PRIVATE_DOCS_PREFIX=/private/docs
# If omitted, AI_ENGINE_API_KEY is used as fallback.
PRIVATE_DOCS_TOKEN=games_private_docs_token

# Periodic generation job (coverage profile)
BATCH_GENERATION_ENABLED=true
BATCH_GENERATION_INTERVAL_MINUTES=20
BATCH_GENERATION_TARGET_COUNT=40
BATCH_GENERATION_MAX_ATTEMPTS=160
BATCH_GENERATION_CONCURRENCY=2
BATCH_GENERATION_MIN_DIFFICULTY=25
BATCH_GENERATION_MAX_DIFFICULTY=85
BATCH_GENERATION_MIN_QUESTIONS=5

# Persistent storage (PostgreSQL service in docker-compose; both games use the quiz database, each row carries its gameType)
DATABASE_URL=postgresql://quiz:quiz@localhost:7432/quizdb?schema=public
